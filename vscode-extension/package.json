{
  "name": "vtrace-vscode",
  "displayName": "vtrace",
  "publisher": "vtrace",
  "description": "Thin VS Code shell for the vtrace CLI and repo-local runtime state.",
  "version": "0.1.0",
  "private": true,
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "main": "./extension.cjs",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vtrace.setupAgent",
    "onCommand:vtrace.showIndexStatus",
    "onCommand:vtrace.generateContextCapsule",
    "onCommand:vtrace.showFileSkeleton",
    "onCommand:vtrace.showImpactGraphAtCursor",
    "onCommand:vtrace.doctor",
    "onCommand:vtrace.refreshStatus",
    "onCommand:vtrace.openOutput",
    "onCommand:vtrace.openSettings",
    "onCommand:vtrace.revealRepoRoot",
    "onCommand:vtrace.openAgentConfigFile",
    "onCommand:vtrace.showFreshnessReport",
    "onCommand:vtrace.showRuntimeReport",
    "onCommand:vtrace.showSetupConfigReport",
    "onCommand:vtrace.showExecutableResolutionReport",
    "onCommand:vtrace.showNoWorkspaceGuidance",
    "onCommand:vtrace.runPipelineForCurrentTask",
    "onCommand:vtrace.setupOrReindex",
    "onView:vtrace.repoStatus",
    "workspaceContains:.git",
    "workspaceContains:.vtrace/config.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vtrace.setupAgent",
        "title": "vtrace: Setup Agent",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showIndexStatus",
        "title": "vtrace: Show Index Status",
        "category": "vtrace"
      },
      {
        "command": "vtrace.generateContextCapsule",
        "title": "vtrace: Generate Context Capsule",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showFileSkeleton",
        "title": "vtrace: Show File Skeleton",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showImpactGraphAtCursor",
        "title": "vtrace: Show Impact Graph for Symbol at Cursor",
        "category": "vtrace"
      },
      {
        "command": "vtrace.doctor",
        "title": "vtrace: Doctor",
        "category": "vtrace"
      },
      {
        "command": "vtrace.refreshStatus",
        "title": "vtrace: Refresh Status",
        "category": "vtrace"
      },
      {
        "command": "vtrace.openOutput",
        "title": "vtrace: Open Output",
        "category": "vtrace"
      },
      {
        "command": "vtrace.openSettings",
        "title": "vtrace: Open Settings",
        "category": "vtrace"
      },
      {
        "command": "vtrace.revealRepoRoot",
        "title": "vtrace: Reveal Repo Root",
        "category": "vtrace"
      },
      {
        "command": "vtrace.openAgentConfigFile",
        "title": "vtrace: Open Agent Config File",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showFreshnessReport",
        "title": "vtrace: Show Freshness Report",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showRuntimeReport",
        "title": "vtrace: Show Runtime Report",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showSetupConfigReport",
        "title": "vtrace: Show Setup / Config Report",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showExecutableResolutionReport",
        "title": "vtrace: Show Executable Resolution Report",
        "category": "vtrace"
      },
      {
        "command": "vtrace.showNoWorkspaceGuidance",
        "title": "vtrace: Show No Workspace Guidance",
        "category": "vtrace"
      },
      {
        "command": "vtrace.runPipelineForCurrentTask",
        "title": "vtrace: Run Pipeline for Current Task",
        "category": "vtrace"
      },
      {
        "command": "vtrace.setupOrReindex",
        "title": "vtrace: Setup / Re-index",
        "category": "vtrace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vtrace",
          "title": "vtrace",
          "icon": "assets/vtrace-activity.svg"
        }
      ]
    },
    "views": {
      "vtrace": [
        {
          "id": "vtrace.repoStatus",
          "name": "Repo Status"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vtrace.repoStatus",
        "contents": "No workspace folder is open.\n[Open Folder](command:vscode.openFolder)\nOnce a folder is open, vtrace will detect the repo automatically.",
        "when": "workbenchState == empty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vtrace.refreshStatus",
          "when": "view == vtrace.repoStatus",
          "group": "navigation@1"
        },
        {
          "command": "vtrace.openOutput",
          "when": "view == vtrace.repoStatus",
          "group": "navigation@2"
        },
        {
          "command": "vtrace.doctor",
          "when": "view == vtrace.repoStatus",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "vtrace",
      "properties": {
        "vtrace.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a vtrace executable, such as a source-checkout bin/vtrace. Set this in the environment where the extension runs, including Remote SSH, WSL, and containers. The extension prepends common Bun/user binary locations when spawning; when empty, it uses a runnable source-checkout launcher if available, then falls back to vtrace on PATH."
        }
      }
    }
  },
  "scripts": {
    "copy-bin": "node ./scripts/copy-bin.mjs",
    "package": "bun run copy-bin && ../node_modules/.bin/vsce package --no-dependencies --allow-missing-repository --skip-license --out vtrace-vscode.vsix"
  }
}
