# Raw agent stream-json captured for pivot-inspection tool-call telemetry. It is
# a large raw log; the normalized `_tool_calls.json` is derived from it. Not
# tracked by default (the per-run raw artifacts are untracked too).
_agent_stream.jsonl

# M194 raw acquisition evidence: per-arm transcripts, snapshots and patches.
# Preserved on disk (§35) and never staged.
benchmarks/stage5_vexp_swe_bench_smoke/results/m194/

# Operator cleanup records: local audit trail of host deletions, never repository evidence
benchmarks/stage5_vexp_swe_bench_smoke/results/stage5_m218_*_operator_cleanup.json

# Assessment data (policy 2026-09-05): benchmark results are our own evidence, not
# what makes vtrace run. Everything under benchmarks/*/results stays on disk only,
# except the frozen experiment authorities the launcher verifies and the ledger.
